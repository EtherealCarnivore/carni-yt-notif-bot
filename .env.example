# Discord Bot Configuration
DISCORD_TOKEN=your_bot_token_here
DISCORD_CHANNEL_ID=your_channel_id_here
DISCORD_ROLE_ID=your_role_id_here

# YouTube Configuration
YOUTUBE_RSS_URL=https://www.youtube.com/feeds/videos.xml?channel_id=YOUR_CHANNEL_ID_HERE

# Membership sync — Discord side
DISCORD_GUILD_ID=your_guild_id_here
DISCORD_OWNER_USER_ID=your_discord_user_id_here
DISCORD_CLIENT_ID=your_discord_app_client_id
DISCORD_CLIENT_SECRET=your_discord_app_client_secret

# Membership sync — StreamElements relay (replaces Google OAuth)
# Get this from streamelements.com → Account → Show secrets → JWT Token
SE_JWT=eyJ...

# Public base URL (Railway domain) — used as Discord OAuth redirect base
PUBLIC_BASE_URL=https://your-bot.up.railway.app

# Persistent data directory (mount a Railway volume here)
DATA_DIR=/data

# How often the role reconcile loop runs (minutes)
RECONCILE_INTERVAL_MIN=30

# Optional — anniversary shoutouts. Channel ID where the bot posts when a
# member crosses a milestone (1mo, 3mo, 6mo, 12mo, 24mo, 36mo, 48mo, 60mo).
DISCORD_ANNIVERSARY_CHANNEL_ID=

# Optional — stats voice channels. Create voice channels (locked so nobody
# can join) and put their IDs here. Names auto-update every 15 min.
STATS_MEMBERS_CHANNEL_ID=
STATS_YT_MEMBERS_CHANNEL_ID=

# Optional — operator alerts. Bot posts here when reconcile or RSS poll
# fails repeatedly. Keep this channel mod-only.
BOT_STATUS_CHANNEL_ID=
